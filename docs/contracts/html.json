      "note": "DrawingML 旋转枢轴恒为形状中心；非 center 原点会改变画面，直接拒绝"
    },
    "flex-direction": {
      "kind": "enum",
      "group": "layout",
      "syntax": "row / column",
      "status": "stable",
      "maps_to": [
        "layout.flex.main_axis"
      ],
      "fixes": [],
      "rejects": [
        "CONTRACT_UNSUPPORTED_VALUE"
      ],
      "values": [
        "row",
        "column"
      ],
      "note": "单行 flex：不支持 wrap 与 *-reverse"
    },
    "justify-content": {
      "kind": "enum",
      "group": "layout",
      "syntax": "flex-start / center / flex-end / space-between / space-around",
      "status": "stable",
      "maps_to": [
        "layout.flex.justify"
      ],
      "fixes": [],
      "rejects": [
        "CONTRACT_UNSUPPORTED_VALUE"
      ],
      "values": [
        "flex-start",
        "center",
        "flex-end",
        "space-between",
        "space-around"
      ]
    },
    "align-items": {
      "kind": "enum",
      "group": "layout",
      "syntax": "flex-start / center / flex-end / stretch",
      "status": "stable",
      "maps_to": [
        "layout.flex.align"
      ],
      "fixes": [],
      "rejects": [
        "CONTRACT_UNSUPPORTED_VALUE"
      ],
      "values": [
        "flex-start",
        "center",
        "flex-end",
        "stretch"
      ]
    },
    "gap": {
      "kind": "length",
      "group": "layout",
      "syntax": "长度（px / em / pt）",
      "status": "stable",
      "maps_to": [
        "layout.flex.gap"
      ],
      "fixes": [
        "fix.unit.percent-to-px",
        "fix.unit.em-to-px",
        "fix.unit.pt-to-px"
      ],
      "rejects": [
        "CONTRACT_UNSUPPORTED_UNIT"
      ],
      "constraints": {
        "min_px": 0
      },
      "note": "单值：主轴与交叉轴同距（row-gap/column-gap 长写不支持）"
    },
    "flex": {
      "kind": "flex",
      "group": "layout",
      "syntax": "none / auto / <grow> [<shrink> [auto]]",
      "status": "stable",
      "maps_to": [
        "layout.flex.item"
      ],
      "fixes": [],
      "rejects": [
        "CONTRACT_UNSUPPORTED_VALUE"
      ],
      "note": "flex-basis 仅 auto；主轴尺寸由声明盒或内容估算给出"
    }
  },
  "fix_rules": {
    "fix.structure.implicit-absolute": {
      "lossless": true,
      "summary": "元素声明了 left/top 却缺 position 时补 absolute"
    },
    "fix.structure.root-origin": {
      "lossless": true,
      "summary": "根画布上的 position 与 left/top=0 属噪声，忽略不影响语义"
    },
    "fix.structure.hidden-subtree": {
      "lossless": true,
      "summary": "display:none 的元素连同子树不进入 IR"
    },
    "fix.unit.percent-to-px": {
      "lossless": true,
      "summary": "百分比按最近定位祖先的对应轴换算为 px"
    },
    "fix.unit.percent-to-multiple": {
      "lossless": true,
      "summary": "line-height 的百分比换算为倍数"
    },
    "fix.unit.em-to-px": {
      "lossless": true,
      "summary": "em 按当前继承字号换算为 px"
    },
    "fix.unit.pt-to-px": {
      "lossless": true,
      "summary": "pt 按 96/72 换算为 px"
    },
    "fix.color.rgb-to-hex": {
      "lossless": true,
      "summary": "rgb()/rgba() 归一为 #RRGGBB，alpha 单独保留"
    },
    "fix.color.named-to-hex": {
      "lossless": true,
      "summary": "具名颜色归一为 #RRGGBB"
    },
    "fix.font.whitelist": {
      "lossless": false,
      "summary": "字体族回落到当前策略白名单中的命中项或默认字体，字形可能变化"
    },
    "fix.compat.display-dropped": {
      "lossless": true,
      "summary": "display 的 block/inline 值在绝对定位模型下丢弃"
    },
    "fix.compat.margin-zero-dropped": {
      "lossless": true,
      "summary": "margin:0 丢弃"
    },
    "fix.table.pad-columns": {
      "lossless": true,
      "summary": "行列数不齐时补空单元格到最大列数"
    },
    "fix.table.cell-width-ignored": {
      "lossless": true,
      "summary": "单元格 width 由表格列宽决定，声明被忽略"
    },
    "fix.table.cell-formatting-dropped": {
      "lossless": false,
      "summary": "单元格内除 <b>/<i> 外的内联标签样式丢弃，只保留文本"
    },
    "fix.paint.opacity-dropped": {
      "lossless": false,
      "summary": "无填充/描边/阴影的元素上的 opacity 无意义，丢弃"
    },
    "fix.media.opacity-dropped": {
      "lossless": false,
      "summary": "图片透明度 v1 不支持，丢弃"
    },
    "fix.compat.box-sizing-dropped": {
      "lossless": true,
      "summary": "box-sizing:border-box 与直写宽高语义一致，声明被吸收"
    },
    "fix.compat.overflow-dropped": {
      "lossless": true,
      "summary": "文本溢出由自动缩字处理，overflow:hidden 被吸收"
    },
    "fix.style.transform-origin-dropped": {
      "lossless": true,
      "summary": "transform-origin 恒为中心（旋转枢轴），声明丢弃"
    },
    "fix.structure.relative-normalized": {
      "lossless": true,
      "summary": "position:relative 按声明盒定位处理（绝对盒模型无文档流）"
    },
    "fix.unit.vw-to-px": {
      "lossless": true,
      "summary": "vw 按画布宽换算（视口即 1280×720 画布）"
    },
    "fix.unit.vh-to-px": {
      "lossless": true,
      "summary": "vh 按画布高换算（视口即 1280×720 画布）"
    },
    "fix.layout.flex-text-absorbed": {
      "lossless": true,
      "summary": "纯文本 flex 容器：居中/对齐吸收为文本对齐"
    },
    "fix.layout.flex-offset-dropped": {
      "lossless": true,
      "summary": "flex 子项的 left/top 在静态流中本就不生效，丢弃"
    },
    "fix.structure.viewport-flattened": {
      "lossless": true,
      "summary": "视口居中壳（100vw/100vh flex + 画布尺寸 stage）合并为画布"
    },
    "fix.structure.root-noise-dropped": {
      "lossless": true,
      "summary": "根画布上无意义的 flex 声明丢弃"
    },
    "fix.layout.static-fill": {
      "lossless": true,
      "summary": "无定位的图片按流式规则放在父内容区左上角"
    },
    "fix.media.border-radius-dropped": {
      "lossless": false,
      "summary": "图片圆角 v1 不支持，按直角渲染"
    }
  },
