      "rejects": [
        "CONTRACT_UNSUPPORTED_VALUE"
      ],
      "values": [
        "absolute",
        "relative"
      ],
      "note": "absolute 为唯一布局模型；relative 在盒已确定时等价（作为定位祖先），缺 left/top 的 relative 元素由 flex 布局给盒"
    },
    "left": {
      "kind": "length",
      "group": "layout",
      "syntax": "长度（px / em / % / pt）",
