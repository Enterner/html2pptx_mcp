{
  "contract": "pptx-html",
  "status": "stable",
  "canvas": {
    "width_px": 1280.0,
    "height_px": 720.0,
    "emu_per_px": 9525,
    "dpi": 96
  },
  "units": {
    "allowed": [
      "px",
      "em",
      "%",
      "pt",
      "vw",
      "vh"
    ],
    "rejected": [
      "rem",
      "vmin",
      "vmax",
      "ex",
      "ch",
      "cm",
      "mm",
      "in",
      "q"
    ]
  },
  "kinds": {
    "enum": "取值必须命中 values 列表",
    "length": "长度：px / % / em / pt，按约束换算或拒绝",
    "color": "颜色：#hex / rgb() / rgba() / 具名色",
    "fill": "填充：纯色或恰好两个色标的 linear-gradient",
    "border": "边框简写：<宽度>px solid|dashed|dotted <颜色> 或 none",
    "radius": "圆角：单值 px 或百分比（四角统一）",
    "opacity": "透明度：0–1",
    "transform": "变换：仅 rotate(<N>deg)",
    "shadow": "阴影：单层外阴影 dx dy [blur] <颜色>",
    "font": "字体族：按字体策略白名单解析",
    "font-weight": "字重：normal / bold / 100–900",
    "line-height": "行高：倍数 / px / %",
    "padding": "内边距：1–4 个长度",
    "letter-spacing": "字距：长度（px，可负），0 表示无",
    "display": "兼容性属性：none 剪枝，block/inline 丢弃，flex/grid 拒绝",
    "margin": "兼容性属性：仅允许 0",
    "writing-mode": "writing-mode: vertical-rl 竖排；horizontal-tb 为默认（无操作）",
    "text-indent": "首行缩进：长度，可为负",
    "clip-path": "clip-path:polygon(...) 顶点（%/px），至少 3 个，映射为自由多边形",
    "flex": "flex 简写：none / auto / <grow> [<shrink> [auto]]（basis 仅 auto）",
    "transform-origin": "变换原点：仅 center / center center（旋转枢轴恒为中心）"
  },
  "tags": {
